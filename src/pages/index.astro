---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import FeatureWidget from '../components/features/FeatureWidget.astro';
import ScorePanel from '../components/features/ScorePanel.astro';
import EvidencePanel from '../components/features/EvidencePanel.astro';
import SuggestionList from '../components/features/SuggestionList.astro';
import EvaluatesSection from '../components/EvaluatesSection.astro';
import CompareTable from '../components/CompareTable.astro';
import TeamSection from '../components/TeamSection.astro';
import { columns, rows, highlight, shortColumns, widths } from '../data/compare.learner';
import { learnerSuggestions, learnerTabs } from '../data/features';
---
<Base title="Onolys — MITI evaluation with evidence for every score" description="Get your MI session evaluated against MITI 4.2.1. Every score linked to the exact transcript lines, with feedback to improve." page="learner">
  <Hero
    title="Get your MI session evaluated. See the evidence for every score."
    description="A full MITI 4.2.1 evaluation of your transcript: global ratings, behavior counts, summary scores and feedback, each linked to the exact lines."
  />
  <Section id="features" tone="features">
    <h2 id="features-heading" class="visually-hidden">Features</h2>
    <FeatureWidget idPrefix="learner-features" tabs={learnerTabs}>
      <ScorePanel slot="panel-0" />
      <EvidencePanel slot="panel-1" />
      <SuggestionList slot="panel-2" label="Next session" items={learnerSuggestions} />
    </FeatureWidget>
    <p class="turnaround">Results in minutes, not the 1 to 2 weeks human coding takes.</p>
  </Section>
  <EvaluatesSection />
  <Section id="compare" tone="compare" heading="How it compares">
    <CompareTable {columns} {rows} {highlight} {shortColumns} {widths} idPrefix="learner-compare" />
  </Section>
  <TeamSection />
</Base>

<style>
  .turnaround { margin-top: 1rem; text-align: center; font-size: 0.85rem; color: var(--color-gray-600); }
</style>
