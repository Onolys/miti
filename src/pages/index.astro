---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import FeatureTabs from '../components/FeatureTabs.astro';
import EvidenceMockup from '../components/mockups/EvidenceMockup.astro';
import CompleteMockup from '../components/mockups/CompleteMockup.astro';
import FeedbackMockup from '../components/mockups/FeedbackMockup.astro';
import EvaluatesSection from '../components/EvaluatesSection.astro';
import CompareTable from '../components/CompareTable.astro';
import TeamSection from '../components/TeamSection.astro';
import { columns, rows, highlight } from '../data/compare.learner';
---
<Base title="Onolys — MITI evaluation with evidence for every score" description="Get your MI session evaluated against MITI 4.2.1. Every score linked to the exact transcript lines, with feedback to improve." page="learner">
  <Hero
    title="Get your MI session evaluated. See the evidence for every score."
    description="A full MITI 4.2.1 evaluation of your transcript: global ratings, behavior counts, summary scores and feedback, each linked to the exact lines."
  />
  <Section id="features" tone="features">
    <h2 id="features-heading" class="visually-hidden">Features</h2>
    <FeatureTabs idPrefix="learner">
      <EvidenceMockup slot="evidence" />
      <CompleteMockup slot="complete" />
      <FeedbackMockup slot="feedback" />
    </FeatureTabs>
    <p class="turnaround">Results in minutes, not the 1 to 2 weeks human coding takes.</p>
  </Section>
  <EvaluatesSection />
  <Section id="compare" tone="compare" heading="How it compares">
    <CompareTable {columns} {rows} {highlight} />
  </Section>
  <TeamSection />
</Base>

<style>
  .turnaround { margin-block: var(--space-6); color: var(--color-gray-600); }
</style>
