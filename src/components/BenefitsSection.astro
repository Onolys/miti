---
import { benefits } from '../data/benefits';
import Section from './Section.astro';
---
<Section id="benefits" tone="benefits" heading="Benefits for your team">
  <div class="benefit-cards">
    {benefits.map((card) => (
      <article>
        <h3>{card.headline}</h3>
        <p>{card.line}</p>
      </article>
    ))}
  </div>
</Section>

<style>
  .benefit-cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); margin-block: var(--space-6) var(--space-8); }
  article { min-width: 0; padding: var(--space-6); border: 1px solid var(--color-gray-300); border-radius: var(--space-3); background: var(--color-gray-50); overflow-wrap: anywhere; }
  h3 { margin: 0 0 var(--space-3); font-size: var(--font-size-lg); line-height: var(--line-height-heading); }
  p { margin: 0; color: var(--color-gray-600); }
  @media (min-width: 64rem) { .benefit-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
