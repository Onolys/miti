---
import type { Page } from '../lib/context';
interface Props {
  page: Page;
}
const { page } = Astro.props;
---
<footer>
  <div class="container">
    <h3>Note:</h3>
    <ul>
      <li>Not official MITI coding and cannot be submitted as one.</li>
      <li>Use it to practice and prepare.</li>
      <li>Role-play or de-identified transcripts only.</li>
    </ul>
    {page === 'enterprise'
      ? <p data-footer-switch>Individuals? <a href="/">Click here</a> — evaluate your own MI session with evidence for every score.</p>
      : <p data-footer-switch>Enterprise? <a href="/enterprise">Click here</a> — bulk evaluations and quality control for your team's MITI coding.</p>}
    <p>Questions? Reach out to <a href="mailto:tejitpabari99@gmail.com">tejitpabari99@gmail.com</a></p>
    <p class="copy">© 2026 Onolys. All rights reserved.</p>
  </div>
</footer>

<style>
  footer { background: var(--tone-footer); color: #dcebe9; padding-block: 3.5rem; font-size: 0.95rem; overflow-wrap: anywhere; }
  a { color: #9fe3d8; }
  h3 { margin: 0 0 0.6rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: #9fcfc8; }
  ul { margin: 0 0 1.75rem; padding-left: 1.2rem; display: grid; gap: 0.25rem; }
  p { margin: 0; }
  p + p { margin-top: 0.75rem; }
  .copy { margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid rgba(255, 255, 255, 0.15); font-size: 0.8rem; color: #9fcfc8; }
</style>
