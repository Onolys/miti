---
import { roleplay as defaultRoleplay } from '../../data/roleplay';
import { CODE_LABELS, summarize, type Code, type GlobalKey, type Roleplay, type Summary } from '../../lib/miti';
import TranscriptPane from '../TranscriptPane.astro';

interface Props { roleplay?: Roleplay; summary?: Summary }
const { roleplay = defaultRoleplay, summary = summarize(roleplay) } = Astro.props;
const globalLabels: Record<GlobalKey, string> = {
  CCT: 'Cultivating change talk', SST: 'Softening sustain talk',
  PARTNERSHIP: 'Partnership', EMPATHY: 'Empathy',
};
const codes = (Object.keys(CODE_LABELS) as Code[]).filter((code) => summary.counts[code] > 0);
const initialLines = summary.linesByCode.CR;
---
<div class="evidence-mockup" data-highlight-root>
  <div class="mockup-heading"><strong>Evidence</strong><span>Fictional learning exercise</span></div>
  <p class="scenario">{roleplay.title}</p>
  <div class="evidence-layout">
    <div class="scorecard">
      <h3>Global ratings <span>(1 to 5)</span></h3>
      <ul class="global-ratings">
        {roleplay.globals.map((rating) => (
          <li data-global={rating.key}>
            <button type="button" data-highlight-lines={rating.lines.join(',')} data-highlight-missed-lines={rating.missedLines?.join(',')} data-highlight-label={globalLabels[rating.key]} aria-pressed="false">
              <span class="row-title">{globalLabels[rating.key]} {rating.score}</span>
              <span class="citations">(lines {rating.lines.join(', ')})</span>
            </button>
            <p class="rationale">{rating.rationale}</p>
            {!!rating.missedLines?.length && <p class="missed-note">{rating.missedLines.join(', ')} not picked up</p>}
          </li>
        ))}
      </ul>
      <h3>Behavior codes</h3>
      <ul class="behavior-codes">
        {codes.map((code) => (
          <li data-behavior-code={code}>
            <button type="button" data-highlight-lines={summary.linesByCode[code].join(',')} data-highlight-label={CODE_LABELS[code]} aria-pressed={code === 'CR' ? 'true' : 'false'}>
              <span class="row-title">{CODE_LABELS[code]} {summary.counts[code]}</span>
              <span class="citations">(lines {summary.linesByCode[code].join(', ')})</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    <div class="transcript-column">
      <h3>Transcript</h3>
      <TranscriptPane roleplay={roleplay} highlightedLines={initialLines} />
      <p class="highlight-status" data-highlight-status aria-live="polite" aria-atomic="true">{initialLines.length ? `${initialLines.length} ${initialLines.length === 1 ? 'line' : 'lines'} highlighted: ${initialLines.join(', ')}.` : 'Highlights cleared.'}</p>
    </div>
  </div>
</div>

<script>
  import { initHighlights } from '../../lib/highlight';
  initHighlights();
  document.addEventListener('astro:page-load', () => initHighlights());
</script>

<style>
  .evidence-mockup { min-width: 0; padding: var(--space-4); border: 1px solid var(--color-gray-300); border-radius: var(--space-3); background: var(--color-gray-50); }
  .mockup-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .mockup-heading strong { font-size: var(--font-size-lg); }
  .mockup-heading > span, .scenario { font-size: var(--font-size-xs); color: var(--color-gray-600); }
  .scenario { margin: var(--space-2) 0 var(--space-4); }
  .evidence-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .scorecard, .transcript-column { min-width: 0; }
  h3 { font-size: var(--font-size-sm); margin: 0 0 var(--space-2); }
  h3 span { font-weight: 400; }
  ul { list-style: none; padding: 0; margin: 0 0 var(--space-4); }
  li + li { margin-top: var(--space-2); }
  button { display: block; width: 100%; padding: var(--space-2); text-align: start; font: inherit; font-size: var(--font-size-sm); color: var(--color-text); background: var(--color-background); border: 1px solid var(--color-gray-300); border-radius: var(--space-1); cursor: pointer; overflow-wrap: anywhere; }
  button[aria-pressed="true"] { border-color: var(--color-accent); box-shadow: inset 3px 0 var(--color-accent); background: var(--color-score-good-background); }
  button:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  .row-title { font-weight: 600; }
  .citations { display: block; font-size: var(--font-size-xs); }
  .rationale, .missed-note, .highlight-status { margin: var(--space-2) 0; font-size: var(--font-size-xs); overflow-wrap: anywhere; }
  .missed-note { color: var(--color-score-fair); font-weight: 600; }
  .highlight-status { min-height: 2.5em; }
  @media (min-width: 64rem) { .evidence-layout { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); } }
</style>
