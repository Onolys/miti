---
import { qcData as defaultQcData, type QcData } from '../../data/roleplay.qc';
import { roleplay as defaultRoleplay } from '../../data/roleplay';
import { summarize, type GlobalKey, type Roleplay } from '../../lib/miti';
import TranscriptPane from '../TranscriptPane.astro';

interface Props { qcData?: QcData; roleplay?: Roleplay }
const { qcData = defaultQcData, roleplay = defaultRoleplay } = Astro.props;
const summary = summarize(roleplay);
const globalLabels: Record<GlobalKey, string> = {
  CCT: 'Cultivating Change Talk', SST: 'Softening Sustain Talk',
  PARTNERSHIP: 'Partnership', EMPATHY: 'Empathy',
};
const rows = [
  ...roleplay.globals.map((rating) => ({
    key: rating.key,
    label: globalLabels[rating.key],
    coder: qcData.coderGlobals[rating.key],
    flag: qcData.flags.find((flag) => flag.kind === 'global' && flag.label === globalLabels[rating.key]),
  })),
  {
    key: 'CR', label: 'Complex reflections', coder: qcData.coderCRCount,
    flag: qcData.flags.find((flag) => flag.kind === 'code'),
  },
];
const flaggedCount = rows.filter(({ flag }) => flag).length;
const initialFlag = rows.find(({ key }) => key === 'EMPATHY')?.flag;
const initialLines = initialFlag?.cites ?? [];
const initialMissed = initialFlag?.missed ?? [];
const statusText = initialLines.length
  ? `${initialLines.length} ${initialLines.length === 1 ? 'line' : 'lines'} highlighted: ${initialLines.join(', ')}.`
  : 'Highlights cleared.';
const missedText = initialMissed.length
  ? ` ${initialMissed.length} ${initialMissed.length === 1 ? 'line' : 'lines'} not picked up: ${initialMissed.join(', ')}.`
  : '';
---
<div class="qc-mockup" data-highlight-root>
  <div class="mockup-heading"><strong>Coder quality check</strong><span>Fictional learning exercise</span></div>
  <p class="scenario">{roleplay.title}</p>
  <p class="review-summary">{rows.length - flaggedCount} supported, {flaggedCount} flagged for review</p>
  <div class="qc-layout">
    <div class="scorecard">
      <h3>Coder scores and session evidence</h3>
      <ul>
        {rows.map((row) => {
          const Tag = row.flag ? 'button' : 'div';
          return (
            <li data-qc-row={row.key}>
              <Tag
                class="score-row"
                type={row.flag ? 'button' : undefined}
                data-highlight-lines={row.flag ? (row.flag.range ? row.flag.range.join('-') : row.flag.cites.join(',')) : undefined}
                data-highlight-missed-lines={row.flag?.missed?.join(',')}
                data-highlight-label={row.flag ? row.label : undefined}
                aria-pressed={row.flag ? row.flag === initialFlag : undefined}
              >
                <span class="row-title">{row.label}</span>
                <span class="coder-score">Coder {row.coder}</span>
                <span class:list={['status-chip', row.flag ? 'flagged' : 'supported']} data-qc-status>{row.flag ? 'Not supported' : 'Supported'}</span>
                {row.flag && <>
                  <span class="supported-score">Session supports {row.flag.supported}</span>
                  <span class="evidence-note">{row.flag.label} {row.flag.coder}: not supported. {row.flag.note}</span>
                </>}
              </Tag>
              {row.key === 'CR' && <p class="context">Session complex reflections: {summary.counts.CR} (lines {summary.linesByCode.CR.join(', ')}).</p>}
            </li>
          );
        })}
      </ul>
      <p class="review-note">Flags are for human review. The coder decides.</p>
    </div>
    <div class="transcript-column">
      <h3>Transcript</h3>
      <TranscriptPane roleplay={roleplay} label="Coder quality-check transcript" highlightedLines={initialLines} missedLines={initialMissed} />
      <p class="highlight-status" data-highlight-status aria-live="polite" aria-atomic="true">{statusText + missedText}</p>
    </div>
  </div>
</div>

<script>
  import { initHighlights } from '../../lib/highlight';
  initHighlights();
  document.addEventListener('astro:page-load', () => initHighlights());
</script>

<style>
  .qc-mockup { min-width: 0; padding: var(--space-4); border: 1px solid var(--color-gray-300); border-radius: var(--space-3); background: var(--color-gray-50); }
  .mockup-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .mockup-heading strong { font-size: var(--font-size-lg); }
  .mockup-heading > span, .scenario { font-size: var(--font-size-xs); color: var(--color-gray-600); }
  .scenario { margin: var(--space-2) 0 var(--space-4); }
  .review-summary { margin: 0 0 var(--space-4); font-size: var(--font-size-sm); font-weight: 600; }
  .qc-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .scorecard, .transcript-column { min-width: 0; }
  h3 { font-size: var(--font-size-sm); margin: 0 0 var(--space-2); }
  ul { list-style: none; padding: 0; margin: 0 0 var(--space-4); }
  li + li { margin-top: var(--space-2); }
  .score-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); width: 100%; padding: var(--space-2); text-align: start; font: inherit; font-size: var(--font-size-sm); color: var(--color-text); background: var(--color-background); border: 1px solid var(--color-gray-300); border-radius: var(--space-1); overflow-wrap: anywhere; }
  button.score-row { cursor: pointer; }
  button[aria-pressed="true"] { border-color: var(--color-accent); box-shadow: inset 3px 0 var(--color-accent); background: var(--color-score-good-background); }
  button:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  .row-title { flex-basis: 100%; font-weight: 600; }
  .status-chip { padding: var(--space-1) var(--space-2); border-radius: var(--space-1); font-size: var(--font-size-xs); font-weight: 600; }
  .supported { color: var(--color-score-good); background: var(--color-score-good-background); }
  .flagged { color: var(--color-score-low); background: var(--color-score-low-background); }
  .supported-score, .evidence-note { flex-basis: 100%; }
  .evidence-note, .context, .review-note, .highlight-status { font-size: var(--font-size-xs); overflow-wrap: anywhere; }
  .context, .review-note, .highlight-status { margin: var(--space-2) 0; }
  .highlight-status { min-height: 2.5em; }
  @media (min-width: 64rem) { .qc-layout { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); } }
</style>
