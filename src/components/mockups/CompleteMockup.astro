---
import { roleplay as defaultRoleplay } from '../../data/roleplay';
import { CODE_LABELS, summarize, type Code, type GlobalKey, type Roleplay, type Summary } from '../../lib/miti';

interface Props { roleplay?: Roleplay; summary?: Summary }
const { roleplay = defaultRoleplay, summary = summarize(roleplay) } = Astro.props;
const globalLabels: Record<GlobalKey, string> = {
  CCT: 'Cultivating change talk', SST: 'Softening sustain talk',
  PARTNERSHIP: 'Partnership', EMPATHY: 'Empathy',
};
const codes = Object.keys(CODE_LABELS) as Code[];
const metrics = [
  { key: 'technical', label: 'Technical', value: summary.metrics.technical.toFixed(1), chip: summary.chips.technical },
  { key: 'relational', label: 'Relational', value: summary.metrics.relational.toFixed(1), chip: summary.chips.relational },
  { key: 'percentCR', label: '% complex reflections', value: summary.metrics.percentCR === null ? null : `${(summary.metrics.percentCR * 100).toFixed(0)}%`, chip: summary.chips.percentCR },
  { key: 'reflectionQuestionRatio', label: 'Reflection-to-question ratio', value: summary.metrics.reflectionQuestionRatio === null ? null : summary.metrics.reflectionQuestionRatio.toFixed(2), chip: summary.chips.reflectionQuestionRatio },
  { key: 'adherent', label: 'MI-adherent', value: String(summary.metrics.adherent), chip: null },
  { key: 'nonAdherent', label: 'MI-non-adherent', value: String(summary.metrics.nonAdherent), chip: null },
];
---
<div class="complete-mockup">
  <div class="mockup-heading"><strong>Complete</strong><span>Fictional learning exercise</span></div>
  <p class="scenario">{roleplay.title}</p>
  <h3>Global ratings <span>(1 to 5)</span></h3>
  <dl class="ratings">
    {roleplay.globals.map((rating) => (
      <div data-global={rating.key}>
        <dt>{globalLabels[rating.key]}</dt>
        <dd data-value>{rating.score.toFixed(1)} / 5</dd>
      </div>
    ))}
  </dl>
  <h3>Behavior counts</h3>
  <dl class="counts">
    {codes.map((code) => (
      <div data-behavior-code={code}>
        <dt>{CODE_LABELS[code]}</dt>
        <dd data-value>{summary.counts[code]}</dd>
      </div>
    ))}
  </dl>
  <div class="summary">
    <h3>Summary</h3>
    <dl class="metrics">
      {metrics.map((metric) => (
        <div data-metric={metric.key}>
          <dt>{metric.label}</dt>
          <dd>
            <span data-value aria-label={metric.value === null ? 'Not available' : undefined}>{metric.value ?? '—'}</span>
            {metric.chip !== null && <span class="chip" data-level={metric.chip}>{metric.chip}</span>}
          </dd>
        </div>
      ))}
    </dl>
    <p class="legend">Reference levels from MITI 4.2.1 (fair / good). Not pass marks.</p>
  </div>
</div>

<style>
  .complete-mockup { min-width: 0; padding: var(--space-4); border: 1px solid var(--color-gray-300); border-radius: var(--space-3); background: var(--color-gray-50); }
  .mockup-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .mockup-heading strong { font-size: var(--font-size-lg); }
  .mockup-heading > span, .scenario, .legend { font-size: var(--font-size-xs); color: var(--color-gray-600); }
  .scenario { margin: var(--space-2) 0 var(--space-4); }
  h3 { margin: 0 0 var(--space-2); font-size: var(--font-size-sm); }
  h3 > span { font-weight: 400; }
  dl { margin: 0 0 var(--space-6); display: grid; gap: var(--space-2) var(--space-4); }
  dl > div { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); padding: var(--space-2); border-bottom: 1px solid var(--color-gray-300); min-width: 0; }
  dt { font-size: var(--font-size-sm); overflow-wrap: anywhere; }
  dd { margin: 0; flex-shrink: 0; font-variant-numeric: tabular-nums; font-size: var(--font-size-sm); font-weight: 600; }
  .summary { border: 1px solid var(--color-gray-300); border-radius: var(--space-2); padding: var(--space-3); background: var(--color-background); }
  .metrics { margin-bottom: var(--space-3); }
  .metrics > div { flex-wrap: wrap; }
  .metrics dd { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); }
  .chip { display: inline-block; padding: var(--space-1) var(--space-2); border-radius: var(--space-1); font-size: var(--font-size-xs); }
  .chip[data-level="Good"] { color: var(--color-score-good); background: var(--color-score-good-background); }
  .chip[data-level="Fair"] { color: var(--color-score-fair); background: var(--color-score-fair-background); }
  .chip[data-level="Below fair"] { color: var(--color-score-low); background: var(--color-score-low-background); }
  .legend { margin: 0; }
  @media (min-width: 48rem) { .ratings, .counts, .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
