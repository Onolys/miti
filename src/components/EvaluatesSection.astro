---
import { evaluates } from '../data/evaluates';
import Section from './Section.astro';
---
<Section id="evaluates" tone="evaluates" heading="What it evaluates">
  <div class="evaluation-cards">
    {evaluates.map((card) => (
      <article>
        <h3>{card.headline}</h3>
        <p>{card.line}</p>
      </article>
    ))}
  </div>
</Section>

<style>
  .evaluation-cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); margin-block: var(--space-6) var(--space-8); }
  article { min-width: 0; padding: var(--space-6); border: 1px solid var(--color-gray-300); border-radius: var(--space-3); background: var(--color-gray-50); overflow-wrap: anywhere; }
  h3 { margin: 0 0 var(--space-3); font-size: var(--font-size-lg); line-height: var(--line-height-heading); }
  p { margin: 0; color: var(--color-gray-600); }
  @media (min-width: 40rem) { .evaluation-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .evaluation-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
