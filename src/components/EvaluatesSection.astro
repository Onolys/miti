---
import { evaluates } from '../data/evaluates';
import Section from './Section.astro';
---
<Section id="evaluates" tone="evaluates" heading="What it evaluates">
  <div class="evaluation-cards">
    {evaluates.map((card) => (
      <article>
        <h3>{card.headline}</h3>
        <p>{card.line}</p>
      </article>
    ))}
  </div>
</Section>

<style>
  .evaluation-cards { display: grid; grid-template-columns: minmax(0, 1fr); grid-auto-rows: 1fr; gap: 1.25rem; margin-block: var(--space-6) var(--space-8); }
  article { min-width: 0; padding: 1.4rem; border: 1px solid #dde4ec; border-radius: 14px; background: #fff; overflow-wrap: anywhere; }
  h3 { margin: 0 0 0.5rem; font-size: 1.1rem; line-height: var(--line-height-heading); color: var(--color-accent); }
  p { margin: 0; color: var(--color-gray-600); font-size: 0.95rem; }
  @media (min-width: 40rem) { .evaluation-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .evaluation-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
