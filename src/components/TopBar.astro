---
import CtaButton from './CtaButton.astro';
import type { Page } from '../lib/context';
interface Props {
  page: Page;
}
const { page } = Astro.props;
const secondary = page === 'enterprise' ? { href: '/', label: 'Individuals' } : { href: '/enterprise', label: 'Enterprise' };
const links = [
  { href: '#features', label: 'Features' },
  { href: '#evaluates', label: 'Evaluation' },
  { href: '#compare', label: 'Comparison' },
  { href: '#team', label: 'Team' },
];
---
<header>
  <div class="container bar">
    <a class="brand" href="#top" aria-label="Onolys, back to top">Onolys</a>
    <nav aria-label="Sections">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="secondary" href={secondary.href}>{secondary.label}</a>
    <div class="cta"><CtaButton trigger="topbar" /></div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--color-gray-100);
    backdrop-filter: blur(6px);
  }
  .bar { display: flex; align-items: center; gap: 1.25rem; min-height: var(--hdr); }
  .brand { color: var(--color-text); text-decoration: none; font-size: 1.15rem; font-weight: 700; letter-spacing: -0.01em; }
  nav { display: flex; flex: 1; justify-content: center; gap: 0.25rem; }
  nav a, .secondary { color: var(--color-gray-600); text-decoration: none; font-size: 0.92rem; font-weight: 500; padding: 0.4rem 0.75rem; border-radius: 8px; white-space: nowrap; }
  nav a:hover, .secondary:hover { color: var(--color-accent); background: var(--color-gray-50); }
  a:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  .cta :global(button) { min-height: 38px; padding: 0.45rem 1rem; font-size: 0.875rem; white-space: nowrap; }

  @media (max-width: 47.5rem) {
    .bar { flex-wrap: wrap; gap: 0.6rem; row-gap: 0; padding-top: 0.55rem; }
    .brand { font-size: 1.05rem; }
    .secondary { margin-left: auto; padding: 0.3rem 0.5rem; }
    nav { order: 5; flex: 0 0 100%; justify-content: flex-start; overflow-x: auto; scrollbar-width: none; margin-inline: -8px; padding-bottom: 0.3rem; }
    nav::-webkit-scrollbar { display: none; }
    nav a { padding: 0.3rem 0.7rem; }
  }
</style>
