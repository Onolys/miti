---
import CtaButton from './CtaButton.astro';
---
<header>
  <a href="#top" aria-label="Onolys, back to top">Onolys</a>
  <CtaButton trigger="topbar" />
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: min(100%, 72rem);
    margin-inline: auto;
    padding: var(--space-4) var(--gutter);
  }

  a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--font-size-xl);
    font-weight: 700;
  }
</style>
