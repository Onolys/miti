---
import CtaButton from './CtaButton.astro';
interface Props {
  id: string;
  heading?: string;
  cta?: boolean;
}
const { id, heading, cta = true } = Astro.props;
---
<section id={id} aria-labelledby={heading ? `${id}-heading` : undefined}>
  {heading && <h2 id={`${id}-heading`}>{heading}</h2>}
  <slot />
  {cta && <CtaButton trigger={`section:${id}`} />}
</section>

<style>
  section {
    width: min(100%, 72rem);
    margin-inline: auto;
    padding: var(--space-12) var(--gutter);
  }

  h2 {
    font-size: var(--font-size-2xl);
    line-height: var(--line-height-heading);
  }
</style>
