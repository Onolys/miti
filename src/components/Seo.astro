---
interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}
const SITE = 'https://miti.onolys.com';
const { title, description, path = '/', noindex = false } = Astro.props;
const base = Astro.site ?? new URL(SITE);
const url = new URL(path, base).href;
const image = new URL('/og.png', base).href;
const imageAlt = 'Onolys: MITI evaluation with evidence for every score';
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#0b5f5a" />
{!noindex && <link rel="canonical" href={url} />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Onolys" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
