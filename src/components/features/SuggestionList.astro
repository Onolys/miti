---
import type { Suggestion } from '../../data/features';
interface Props { label?: string; items: readonly Suggestion[] }
const { label, items } = Astro.props;
---
{label && <div class="lbl">{label}</div>}
{items.map((item) => (
  <div class="sug" data-suggestion>
    <svg viewBox="0 0 28 28" aria-hidden="true" focusable="false">
      <rect width="28" height="28" rx="8" fill="#d5ebe8" />
      {item.icon === 'reflect' && <path d="M8 9h12v8h-6l-3 3v-3H8z" fill="none" stroke="#0b5f5a" stroke-width="1.8" stroke-linejoin="round" />}
      {item.icon === 'question' && <><path d="M10.5 11a3.5 3.5 0 1 1 5 3.1c-.9.5-1.5 1-1.5 2" fill="none" stroke="#0b5f5a" stroke-width="1.8" stroke-linecap="round" /><circle cx="14" cy="20" r="1.2" fill="#0b5f5a" /></>}
      {item.icon === 'affirm' && <path d="M8 15l4 4 8-9" fill="none" stroke="#0b5f5a" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />}
    </svg>
    <div><b>{item.title}</b><span>{item.text}</span></div>
  </div>
))}

<style>
  .lbl { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-gray-600); font-weight: 600; }
  .sug { display: flex; gap: 0.8rem; align-items: flex-start; background: #fff; border: 1px solid var(--color-gray-100); border-radius: 10px; padding: 0.7rem 0.85rem; font-size: 0.875rem; }
  .sug svg { flex: none; width: 28px; height: 28px; }
  .sug b { display: block; font-size: 0.9rem; }
  .sug span { color: var(--color-gray-600); font-size: 0.82rem; }
</style>
