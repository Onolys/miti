---
import { globalRatings, summaryScores } from '../../data/features';
---
<div class="lbl">Global ratings</div>
<div class="rates">
  {globalRatings.map((rating) => (
    <div class="rate" data-rating>
      <span>{rating.label}</span>
      <div class="bar"><i style={`width:${(rating.value / 5) * 100}%`}></i></div>
      <b>{rating.value.toFixed(1)}/5</b>
    </div>
  ))}
</div>
<div class="lbl">Summary scores</div>
<div class="chips">
  {summaryScores.map((score) => (
    <div class="chip" data-chip>{score.label}<b>{score.value}{'tag' in score && <> <span class={`tag ${score.tag === 'Good' ? 'good' : 'fair'}`}>{score.tag}</span></>}</b></div>
  ))}
</div>

<style>
  .lbl { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-gray-600); font-weight: 600; }
  .rates { display: grid; gap: 0.6rem; }
  .rate { display: grid; grid-template-columns: 11.5rem 1fr 3rem; align-items: center; gap: 0.75rem; font-size: 0.85rem; }
  .bar { height: 8px; background: var(--color-gray-100); border-radius: 99px; overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--color-accent); border-radius: 99px; }
  .rate b { text-align: right; font-variant-numeric: tabular-nums; }
  .chips { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
  .chip { background: #fff; border: 1px solid var(--color-gray-100); border-radius: 10px; padding: 0.55rem 0.75rem; display: flex; flex-direction: column; gap: 0.1rem; font-size: 0.75rem; color: var(--color-gray-600); }
  .chip b { color: var(--color-text); font-size: 1.05rem; font-variant-numeric: tabular-nums; display: flex; align-items: center; gap: 0.5rem; }
  .tag { font-size: 0.68rem; font-weight: 600; padding: 0.05rem 0.5rem; border-radius: 99px; }
  .tag.good { color: var(--color-score-good); background: var(--color-score-good-background); }
  .tag.fair { color: var(--color-score-fair); background: var(--color-score-fair-background); }
  @container (max-width: 700px) {
    .rate { grid-template-columns: 1fr 2.5rem; gap: 0.2rem 0.5rem; }
    .bar { grid-column: 1 / -1; grid-row: 2; }
    .rate span { grid-column: 1; }
    .rate b { grid-column: 2; grid-row: 1; }
  }
</style>
