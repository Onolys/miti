---
import type { FeatureTab } from '../../data/features';

interface Props {
  idPrefix: string;
  tabs: readonly FeatureTab[];
}
const { idPrefix, tabs } = Astro.props;
const tabId = (i: number) => `${idPrefix}-tab-${i}`;
const panelId = (i: number) => `${idPrefix}-panel-${i}`;
---
<div class="cq">
  <div class="fw" data-tabs data-orientation="vertical" data-orientation-narrow="horizontal" data-narrow-width="700" data-active="0">
    <div class="tabs" role="tablist" aria-label="Product features" aria-orientation="vertical">
      {tabs.map((tab, i) => (
        <button type="button" class="tab" role="tab" id={tabId(i)} aria-controls={panelId(i)} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <span class="h">{tab.heading}</span>
          <span class="d">{tab.line}</span>
        </button>
      ))}
    </div>
    <div class="panel">
      <div class="win">
        <div class="win-bar"><span>Onolys · Session report</span></div>
        <div class="screens">
          {tabs.map((tab, i) => (
            <div class="screen" role="tabpanel" id={panelId(i)} aria-labelledby={tabId(i)} tabindex="0" hidden={i !== 0} inert={i !== 0}>
              <p class="sdesc">{tab.line}</p>
              {i === 0 && <slot name="panel-0" />}
              {i === 1 && <slot name="panel-1" />}
              {i === 2 && <slot name="panel-2" />}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initTabs } from '../../lib/tabs';
  initTabs();
  document.addEventListener('astro:page-load', () => initTabs());
</script>

<style>
  .cq { container-type: inline-size; }
  .fw { display: grid; grid-template-columns: 1fr 2fr; align-items: stretch; }
  .tabs { display: flex; flex-direction: column; }
  .tab { flex: 1; text-align: left; font: inherit; color: var(--color-text); background: transparent; border: 1px solid transparent; border-right: 0; border-radius: 14px 0 0 14px; padding: 1rem 1.4rem 1rem 1.25rem; cursor: pointer; display: flex; flex-direction: column; justify-content: center; gap: 0.3rem; }
  .tab .h { font-weight: 700; font-size: 1.05rem; letter-spacing: -0.01em; line-height: 1.25; }
  .tab .d { font-size: 0.875rem; color: var(--color-gray-600); line-height: 1.45; }
  .tab[aria-selected='false']:hover { background: rgba(255, 255, 255, 0.5); }
  .tab[aria-selected='true'] { background: #fff; border-color: #a9cbc6; margin-right: -1px; position: relative; z-index: 2; }
  .tab[aria-selected='true'] .h { color: var(--color-accent); }
  .panel { background: #fff; border: 1px solid #a9cbc6; border-radius: 0 14px 14px 0; padding: 1rem; display: flex; }
  .win { flex: 1; min-width: 0; border: 1px solid var(--color-gray-100); border-radius: 10px; background: var(--color-gray-50); overflow: hidden; display: flex; flex-direction: column; }
  .win-bar { display: flex; align-items: center; padding: 0.5rem 0.8rem; background: var(--color-gray-100); font-size: 0.75rem; font-weight: 600; color: var(--color-gray-600); }
  .screens { display: grid; flex: 1; }
  /* Stack all panels in one grid cell so the widget keeps one height; inactive ones are invisible to AT. */
  .screen { grid-area: 1 / 1; padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.9rem; min-width: 0; }
  .screen[hidden] { display: flex; visibility: hidden; }
  .sdesc { display: none; font-size: 0.85rem; color: var(--color-gray-600); margin: 0; }
  @container (max-width: 700px) {
    .fw { grid-template-columns: 1fr; }
    .tabs { flex-direction: row; align-items: flex-end; gap: 4px; }
    .tab { border: 1px solid transparent; border-bottom: 0; border-radius: 12px 12px 0 0; padding: 0.6rem 0.5rem; justify-content: flex-start; min-width: 0; flex: 1 1 0; }
    .tab .h { font-size: 0.74rem; }
    .tab .d { display: none; }
    .tab[aria-selected='true'] { margin-right: 0; margin-bottom: -1px; }
    .panel { border-radius: 14px; padding: 0.6rem; }
    .fw[data-active='0'] .panel { border-top-left-radius: 0; }
    .fw[data-active='2'] .panel { border-top-right-radius: 0; }
    .screen { padding: 0.8rem; gap: 0.7rem; }
    .sdesc { display: block; }
  }
</style>
