# Production guard and Astro build load .env, .env.local, .env.production,
# then .env.production.local (last file wins); process environment wins over files.
# Plain npm run build tolerates missing values; build:prod and deploy require both below.
# Public build-time values: these are visible in the generated website.
# Apps Script web-app endpoint, supplied after its deployment.
PUBLIC_SIGNUP_URL=
# GA4 measurement ID (G-...). Leave blank to disable analytics locally.
PUBLIC_GA_ID=
# Optional plan recorded by the sign-up flow.
PUBLIC_SIGNUP_PLAN=
